{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "ConnectionString": "Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;Persist Security Info=False;User ID=<user>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=10;",
    "Url": "https://<environment-host>",
    "Environment": "Dev",
    "JwtSigningKey": "<replace-with-a-256-bit-random-key-DISTINCT-from-CMS's-key-for-this-environment>",
    "GmfaKey": "<must-match-the-corresponding-CMS-environment's-GmfaKey-exactly>",
    "CmsUrl": "<CMSNEO's own URL for this same environment, e.g. https://qacmsneo.azurewebsites.net>"
  }
}
